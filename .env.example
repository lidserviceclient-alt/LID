# Copier vers .env.local pour le développement. Les fichiers .env.staging / .env.production portent les valeurs de déploiement.

# API back-office
VITE_BACKOFFICE_API_URL=http://localhost:9000

# URL de la boutique (liens « Accueil » et « Mon compte » du menu). Sans slash final obligatoire.
# staging    : https://lid-shop-staging.web.app
# production : https://lidshopping.com   (valeur de repli si la variable est absente)
VITE_STOREFRONT_URL=https://lid-shop-staging.web.app

# Optionnel : URL complète de « Mon compte » si distincte de <VITE_STOREFRONT_URL>/profile
# VITE_ACCOUNT_URL=
